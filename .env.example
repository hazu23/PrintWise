# Copy this file to ".env" and set a private secret key.
# Keep .env out of Git. Generate a key with:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-this-with-a-long-random-value

# MySQL connection (XAMPP defaults: root user with no password)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=printwise_app
DB_PASSWORD=choose-a-strong-password
DB_NAME=printwise
