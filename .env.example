# Copy this file to ".env" and edit the values. Never commit ".env".

# Long random text. Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-long-random-string

# --- Database (XAMPP defaults: user root, empty password) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=printwise

# --- Email (SMTP) ---
# Leave MAIL_USERNAME empty and emails are printed in the terminal instead of sent.
# For Gmail: turn on 2-Step Verification, create an "App password", and use it below.
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=PrintWise <no-reply@printwise.local>

# Public address of the site, used in links inside emails
APP_BASE_URL=http://127.0.0.1:5000

# Set to true only when the site is served over HTTPS
SESSION_COOKIE_SECURE=false
